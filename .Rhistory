group_by(Trait) %>%
summarise(mean_r = round(mean(Cor, na.rm=TRUE), 3),
sd_r   = round(sd(Cor,   na.rm=TRUE), 3), .groups="drop") %>%
arrange(desc(mean_r))
cat("Agronomic (BLUE) — mean GBLUP accuracy by trait:\n"); print(ag_sum)
cat("\nMalt quality (raw) — mean GBLUP accuracy by trait:\n"); print(mq_sum)
